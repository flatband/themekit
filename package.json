{
  "name": "themekit",
  "version": "0.1.0",
  "description": "Headless named-theme switching for Next.js, with an optional daily random pick",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "next-themes": ">=0.4",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19",
    "next-themes": "^0.4.6",
    "react": "^19",
    "typescript": "^5"
  }
}
